{
  // The top level is the dev environment, in the factory account. There is no
  // production environment yet.
  //
  // No account_id: wrangler reads CLOUDFLARE_ACCOUNT_ID, so the account stays
  // out of this public repo.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saw-orchestrator",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // The agent instructions are bundled as text and written into each run's container.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "preview_urls": false,
  "observability": { "enabled": true },

  // Empty values fail closed: with no approver or no repos, every release is
  // ignored. deploy.sh passes the real values from .env.local with --var. They
  // aren't committed because a consumer's repo name can be private.
  "vars": {
    "BUILD_ID": "0.0.0+dev",
    "GITHUB_APP_ID": "",
    "APPROVER_LOGIN": "",
    "ALLOWED_REPOS": "",
    "EGRESS_HOSTS": "{}",
    // The models the agent runner uses (src/agents/claude-code.ts). Any other is refused.
    "ALLOWED_MODELS": "claude-sonnet-5-5,claude-haiku-5-5",
    // Model spend (#92). Dollars per million tokens; a model with no price is refused.
    // Haiku is priced at its rate for prompts over 100K tokens, so there's one price.
    "MODEL_PRICES": "{\"claude-sonnet-5-5\":{\"input\":2,\"output\":10,\"cacheWrite5m\":2.5,\"cacheWrite1h\":4,\"cacheRead\":0.2},\"claude-haiku-5-5\":{\"input\":0.5,\"output\":2.5,\"cacheWrite5m\":0.625,\"cacheWrite1h\":1,\"cacheRead\":0.05}}",
    // A run, a release with its resumes, and a UTC calendar month, in dollars.
    "RUN_BUDGET_USD": "5",
    "ISSUE_BUDGET_USD": "8",
    "MONTHLY_BUDGET_USD": "15",
    // The largest max_tokens a call may ask for. Claude Code is told the same.
    "MAX_OUTPUT_TOKENS": "32000"
  },

  // DELIVERY_LOG records webhook deliveries so a redelivery doesn't release an issue
  // twice. Deleting it breaks /webhook. RUN_STATE holds each run's stop flag, pinned
  // branch and PR, and token.
  "durable_objects": {
    "bindings": [
      { "name": "DELIVERY_LOG", "class_name": "DeliveryLog" },
      { "name": "RUN_STATE", "class_name": "RunState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DeliveryLog"] },
    { "tag": "v2", "new_sqlite_classes": ["RunState"] }
  ],

  // Each RunState starts one container for its run (#79). `wrangler deploy`
  // builds the image, so it needs Docker. Tests run with containers off.
  "containers": [
    {
      "class_name": "RunState",
      "scheduling_policy": "durable_object",
      "images": { "agent": { "dockerfile": "./container/Dockerfile" } }
    }
  ]

  // Worker secrets, set by hand and never committed. None enters the sandbox:
  //   GITHUB_APP_PRIVATE_KEY  PKCS#8 PEM
  //   GITHUB_WEBHOOK_SECRET
  //   ANTHROPIC_API_KEY, OPENAI_API_KEY  optional. A model host with no key is denied
}
