#!/usr/bin/env python3
"""Checker for Cloudflare API tokens (ADR-007).

    printf %s "$TOKEN" | checks/cloudflare [workers] [kv] [r2] [d1] [queues] [zones]

The token arrives on stdin. Arguments are the manifest's `check` words: each
names something the token must be able to list. Without `zones`, the token must
not be able to read any zone's DNS records or settings.

Always checks:
  - the token is active (user tokens; account-owned tokens are not supported yet);
  - it reaches exactly one account, which is reported as IDENTITY;
  - zone access, as above. A token with only account permissions can still list
    the account's zone names (seen with Workers Scripts), so listing alone is INFO.

Writes PASS, FAIL and INFO lines, EXPIRES when the token has an expiry, and
IDENTITY. Exits 1 if any check fails. Never prints the token. Standard library
only.
"""

import json
import sys
import urllib.error
import urllib.request

API = "https://api.cloudflare.com/client/v4"

# check word -> (account-scoped path, what it lists)
CAPABILITIES = {
    "workers": ("workers/scripts", "Workers scripts"),
    "kv": ("storage/kv/namespaces", "KV namespaces"),
    "r2": ("r2/buckets", "R2 buckets"),
    "d1": ("d1/database", "D1 databases"),
    "queues": ("queues", "queues"),
}

# Zone-scoped reads a token without zone permissions is refused (zone path, what).
ZONE_PROBES = (("dns_records?per_page=1", "DNS records"), ("settings", "settings"))


def call(token: str, path: str):
    """GET API/path. Returns (ok, body). Never raises on an HTTP error."""
    req = urllib.request.Request(
        f"{API}/{path}",
        headers={"Authorization": f"Bearer {token}", "User-Agent": "saw-credential-check"},
    )
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            body = json.load(resp)
    except urllib.error.HTTPError as err:
        try:
            body = json.load(err)
        except ValueError:
            body = {"success": False, "errors": [{"code": err.code, "message": err.reason}]}
    except (urllib.error.URLError, TimeoutError) as err:
        return False, {"errors": [{"code": "network", "message": str(err)}]}
    return bool(body.get("success")), body


def first_error(body) -> str:
    errors = body.get("errors") or []
    if not errors:
        return "no error detail"
    e = errors[0]
    return f"{e.get('message', '')} (code {e.get('code', '?')})"


def run(token: str, words: list, call=call) -> list:
    """Return the output lines. Separate from main so tests can stub `call`."""
    out = []
    unknown = [w for w in words if w not in CAPABILITIES and w != "zones"]
    if unknown:
        return [f"FAIL unknown check words: {' '.join(unknown)}"]
    if not token:
        return ["FAIL empty token"]

    ok, body = call(token, "user/tokens/verify")
    if not ok:
        return [f"FAIL token not accepted: {first_error(body)}. Account-owned tokens are not supported yet"]
    result = body.get("result") or {}
    if result.get("status") != "active":
        return [f"FAIL token status is {result.get('status')!r}, not active"]
    out.append("PASS token is active")
    if result.get("expires_on"):
        out.append(f"EXPIRES {result['expires_on'][:10]}")
    else:
        out.append("INFO token has no expiry date")

    ok, body = call(token, "accounts?per_page=50")
    accounts = (body.get("result") or []) if ok else []
    if not ok:
        out.append(f"FAIL cannot list accounts: {first_error(body)}")
        return out
    if len(accounts) != 1:
        out.append(f"FAIL token reaches {len(accounts)} accounts; scope it to exactly one")
        return out
    account = accounts[0]
    out.append(f"PASS reaches one account: {account.get('name')}")
    out.append(f"IDENTITY {account['id']} {account.get('name', '')}".rstrip())

    ok, body = call(token, "zones?per_page=50")
    zone_list = (body.get("result") or []) if ok else []
    zones = (body.get("result_info") or {}).get("total_count", len(zone_list)) if ok else 0
    if "zones" in words:
        out.append(f"INFO reaches {zones} zone(s)")
    elif zones:
        names = ", ".join(z.get("name", "?") for z in zone_list[:5])
        readable = [f"{what} of {z.get('name', '?')}"
                    for z in zone_list for path, what in ZONE_PROBES
                    if call(token, f"zones/{z.get('id')}/{path}")[0]]
        if readable:
            out.append(f"FAIL can read {', '.join(readable)}; this token should have no zone permissions")
        else:
            out.append(f"INFO lists {zones} zone(s) ({names}) but can't read their DNS records or settings")
            out.append("PASS no zone permissions found")
    else:
        out.append("PASS reaches no zones")

    for word in words:
        if word == "zones":
            continue
        path, what = CAPABILITIES[word]
        ok, body = call(token, f"accounts/{account['id']}/{path}")
        if ok:
            out.append(f"PASS can list {what}")
        else:
            out.append(f"FAIL cannot list {what}: {first_error(body)}")
    return out


def main() -> int:
    token = sys.stdin.read().strip()
    lines = run(token, sys.argv[1:])
    for line in lines:
        print(line)
    return 1 if any(line.startswith("FAIL") for line in lines) else 0


if __name__ == "__main__":
    sys.exit(main())
